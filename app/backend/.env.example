# Option A: a full URL (used by tests / quick local runs with SQLite)
# DATABASE_URL=sqlite:///./local.db

# Option B: discrete settings (how the app is configured inside Kubernetes:
# DB_HOST/DB_NAME/DB_PORT come from a ConfigMap, DB_USER/DB_PASSWORD from a Secret)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasks
DB_USER=tasks_user
DB_PASSWORD=change_me

LOG_LEVEL=INFO
APP_VERSION=local
